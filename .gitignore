# ==============================================================================
# AI Smart Scheduler — Monorepo .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.*
!.env.example
!.env.*.example
!backend/.env.example
!backend/.env.*.example
!frontend/.env.example
!frontend/.env.*.example

# ------------------------------------------------------------------------------
# 2. Database Development (SQLite & Journals)
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/*.db
backend/*.db-journal
backend/*.db-wal
backend/*.db-shm
backend/*.sqlite
backend/*.sqlite3
backend/**/*.db
backend/**/*.sqlite
backend/**/*.sqlite3
scheduler.db

# ------------------------------------------------------------------------------
# 3. Backend (Python / FastAPI / Alembic / Pytest)
# ------------------------------------------------------------------------------
# Python Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
backend/.venv/
backend/venv/
backend/env/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Testing, Coverage, Profiling & Linting Cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py.cover
*.prof

# Python Packaging & Distribution
build/
dist/
backend/build/
backend/dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 4. Frontend (React / Vite / Node)
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
frontend/node_modules/

# Build Outputs
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
frontend/build/

# Vite, Tooling & Bundler Cache
.vite/
frontend/.vite/
frontend/node_modules/.vite/
.cache/
frontend/.cache/
*.tsbuildinfo

# Frontend Testing & Coverage
coverage/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/

# Frontend Local Env & Config
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.production.local
*.local

# Node / Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 5. General Logs, Temp, OS & IDE
# ------------------------------------------------------------------------------
*.log
logs/
tmp/
temp/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Settings
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
